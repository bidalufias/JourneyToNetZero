# Point the front end at the Supabase project that runs the authoritative room.
# With both unset the app falls back to the local one-browser transport, which
# is enough for development and for rehearsing a session on a laptop.
VITE_SUPABASE_URL=https://dsibzzchpokqwscjrbif.supabase.co
# Use the legacy anon key (a JWT). The newer sb_publishable_* keys are not
# JWTs and the edge function verifies one, so they would be rejected.
VITE_SUPABASE_ANON_KEY=
